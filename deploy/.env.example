# Copy to deploy/.env on the server and fill in the empty values.
# deploy/.env is git-ignored and never copied into the image. Never commit real values.

# LLM provider: "groq" (default) or "anthropic"
LLM_PROVIDER=groq
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Revive MySQL database created by deploy/mysql-setup.sql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=copilot_revive
# Read-only user for the app
MYSQL_USERNAME=copilot_app
MYSQL_PASSWORD=
# Loader user for setup and the scheduler (rights on copilot_revive only)
MYSQL_LOADER_USERNAME=copilot_loader
MYSQL_LOADER_PASSWORD=

# ClickHouse (the app and loaders use the adexchange database)
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# Web: the API listens on 127.0.0.1:COPILOT_PORT; the proxy serves it at /copilot/
# (the proxy tells the app its path with X-Forwarded-Prefix; see the snippets)
COPILOT_PORT=8000
COOKIE_SECURE=true
ALLOW_SIGNUP=false
ENABLE_API_DOCS=false

LOG_LEVEL=INFO
