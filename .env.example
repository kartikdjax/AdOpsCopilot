# Copy to .env and fill in. .env is git-ignored; never commit real values.

# LLM provider: "groq" (default) or "anthropic"
LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_API_KEY=

# MySQL - revive domain (local Revive Adserver install)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=revive608
MYSQL_USERNAME=root
MYSQL_PASSWORD=
